{

	"theme": "Default Dark.sublime-theme",
	"index_files": true,
	"auto_complete_triggers":
	[
		{
			"characters": "<",
			"selector": "text.html, text.xml",
		},
		{
			"rhs_empty": true,
			"selector": "punctuation.accessor",
		},
		{
			"characters": "\\",
			"selector": "text.tex.latex",
		}
	],
	"font_size": 24,
	"ignored_packages":
	[
		"Vintage",
	],
}
